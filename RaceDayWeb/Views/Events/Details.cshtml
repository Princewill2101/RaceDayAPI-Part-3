@model EventDetailsViewModel
@{ ViewData["Title"] = Model.Event.Name; var ev = Model.Event; }

<a asp-action="Index" class="rd-back"><i class="bi bi-arrow-left"></i> All events</a>

<div class="rd-card p-0 overflow-hidden mt-2">
    @if (!string.IsNullOrEmpty(ev.BannerImageUrl))
    {
        <img src="@ev.BannerImageUrl" alt="@ev.Name banner" class="rd-banner rd-banner-lg" />
    }
    else
    {
        <div class="rd-banner rd-banner-lg rd-banner-fallback"><i class="bi bi-lightning-charge-fill"></i></div>
    }
    <div class="p-4">
        <span class="badge rd-type-badge">@ev.EventType</span>
        <h1 class="rd-title mt-2">@ev.Name</h1>
        <div class="row g-3 my-2">
            <div class="col-md-4"><div class="rd-stat"><i class="bi bi-calendar-event"></i><span>@ev.EventDate.ToString("dddd, d MMMM yyyy")</span><small>Starts @ev.EventDate.ToString("HH:mm")</small></div></div>
            <div class="col-md-4"><div class="rd-stat"><i class="bi bi-geo-alt"></i><span>@ev.Location</span><small>Location</small></div></div>
            <div class="col-md-4"><div class="rd-stat"><i class="bi bi-signpost-split"></i><span>@ev.DistanceKm.ToString("0.##") km</span><small>Distance</small></div></div>
        </div>
        @if (!string.IsNullOrWhiteSpace(ev.Description))
        {
            <p class="mt-3">@ev.Description</p>
        }
        <p class="text-muted small mb-0">Organised by @ev.OrganizerName</p>
    </div>
</div>

<div class="rd-card mt-4">
    <h2 class="rd-subtitle">Categories</h2>
    @if (!ev.Categories.Any())
    {
        <p class="mb-0">The organiser hasn't added any categories yet, so entries aren't open.</p>
    }
    else if (Model.AlreadyEnrolled)
    {
        <ul class="list-group mb-3">
            @foreach (var c in ev.Categories)
            {
                <li class="list-group-item d-flex justify-content-between">
                    <span><strong>@c.CategoryName</strong> <span class="text-muted">@c.AgeRange</span></span>
                    @if (c.DistanceKm.HasValue) { <span>@c.DistanceKm.Value.ToString("0.##") km</span> }
                </li>
            }
        </ul>
        <div class="alert alert-success mb-0"><i class="bi bi-check-circle"></i> You've already entered this event.
            <a asp-controller="MyEnrolments" asp-action="Index">View my enrolments</a></div>
    }
    else
    {
        <form asp-action="Enrol" method="post">
            <input type="hidden" name="eventId" value="@ev.EventId" />
            <div class="list-group mb-3">
                @foreach (var c in ev.Categories)
                {
                    <label class="list-group-item d-flex justify-content-between align-items-center">
                        <span>
                            <input class="form-check-input me-2" type="radio" name="categoryId" value="@c.CategoryId" required />
                            <strong>@c.CategoryName</strong> <span class="text-muted">@c.AgeRange</span>
                        </span>
                        @if (c.DistanceKm.HasValue) { <span>@c.DistanceKm.Value.ToString("0.##") km</span> }
                    </label>
                }
            </div>
            <button type="submit" class="btn btn-rd btn-lg">Enter this event</button>
        </form>
    }
</div>
