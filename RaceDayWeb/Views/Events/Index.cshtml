@model EventListViewModel
@{ ViewData["Title"] = "Upcoming events"; }

<h1 class="rd-title">Upcoming events</h1>
<partial name="_LoadError" />

<form method="get" class="rd-card rd-filter mb-4">
    <div class="row g-2 align-items-end">
        <div class="col-md-5">
            <label class="form-label" for="search">Search</label>
            <input type="text" id="search" name="search" value="@Model.Search" class="form-control" placeholder="Event name or location" />
        </div>
        <div class="col-md-3">
            <label class="form-label" for="type">Type</label>
            <select id="type" name="type" class="form-select">
                <option value="">All types</option>
                @foreach (var t in Model.Types)
                {
                    <option value="@t" selected="@(Model.Type == t)">@t</option>
                }
            </select>
        </div>
        <div class="col-md-2">
            <label class="form-label" for="sort">Sort by</label>
            <select id="sort" name="sort" class="form-select">
                <option value="date" selected="@(Model.Sort != "distance" && Model.Sort != "name")">Date</option>
                <option value="distance" selected="@(Model.Sort == "distance")">Distance</option>
                <option value="name" selected="@(Model.Sort == "name")">Name</option>
            </select>
        </div>
        <div class="col-md-2 d-grid">
            <button type="submit" class="btn btn-rd">Filter</button>
        </div>
    </div>
</form>

@if (!Model.Events.Any())
{
    <div class="rd-card text-center py-5">
        <i class="bi bi-calendar-x rd-icon-lg"></i>
        <h3>No events found</h3>
        <p class="mb-0">Try changing your filters, or check back soon.</p>
    </div>
}
else
{
    <div class="row g-4">
        @foreach (var ev in Model.Events)
        {
            <div class="col-md-6 col-lg-4">
                <div class="rd-event-card h-100">
                    @if (!string.IsNullOrEmpty(ev.BannerImageUrl))
                    {
                        <img src="@ev.BannerImageUrl" alt="@ev.Name banner" class="rd-banner" />
                    }
                    else
                    {
                        <div class="rd-banner rd-banner-fallback"><i class="bi bi-lightning-charge-fill"></i></div>
                    }
                    <div class="p-3 d-flex flex-column">
                        <div class="mb-2">
                            <span class="badge rd-type-badge">@ev.EventType</span>
                            @if (Model.EnrolledEventIds.Contains(ev.EventId))
                            {
                                <span class="badge status-confirmed">Entered</span>
                            }
                        </div>
                        <h3 class="rd-event-name">@ev.Name</h3>
                        <ul class="rd-meta list-unstyled mb-3">
                            <li><i class="bi bi-calendar-event"></i> @ev.EventDate.ToString("ddd, d MMM yyyy, HH:mm")</li>
                            <li><i class="bi bi-geo-alt"></i> @ev.Location</li>
                            <li><i class="bi bi-signpost-split"></i> @ev.DistanceKm.ToString("0.##") km</li>
                        </ul>
                        <a class="btn btn-rd mt-auto" asp-action="Details" asp-route-id="@ev.EventId">View event</a>
                    </div>
                </div>
            </div>
        }
    </div>
}
