@{
    var role     = Context.Session.GetString(SessionKeys.UserRole);
    var userName = Context.Session.GetString(SessionKeys.UserName);
    var pic      = Context.Session.GetString(SessionKeys.ProfilePic);
    bool loggedIn = Context.Session.GetInt32(SessionKeys.UserId) != null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - RaceDay</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@600;700;800&family=Inter:wght@400;500;600&display=swap" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-dark rd-navbar">
        <div class="container">
            <a class="navbar-brand rd-brand" asp-controller="Home" asp-action="Index">
                <i class="bi bi-lightning-charge-fill"></i> RACE<span>DAY</span>
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav"
                    aria-controls="mainNav" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="mainNav">
                <ul class="navbar-nav me-auto">
                    @if (loggedIn && role == SessionKeys.Organiser)
                    {
                        <li class="nav-item"><a class="nav-link" asp-controller="Dashboard" asp-action="Index"><i class="bi bi-speedometer2"></i> Dashboard</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="ManageEvents" asp-action="Index"><i class="bi bi-calendar-event"></i> My Events</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="ManageEvents" asp-action="Create"><i class="bi bi-plus-circle"></i> New Event</a></li>
                    }
                    else if (loggedIn && role == SessionKeys.Participant)
                    {
                        <li class="nav-item"><a class="nav-link" asp-controller="Events" asp-action="Index"><i class="bi bi-compass"></i> Upcoming Events</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="MyEnrolments" asp-action="Index"><i class="bi bi-ticket-perforated"></i> My Enrolments</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="MyResults" asp-action="Index"><i class="bi bi-stopwatch"></i> My Results</a></li>
                    }
                </ul>
                <ul class="navbar-nav align-items-lg-center">
                    @if (loggedIn)
                    {
                        <li class="nav-item d-flex align-items-center me-lg-3">
                            <a class="nav-link d-flex align-items-center gap-2" asp-controller="Profile" asp-action="Index">
                                @if (!string.IsNullOrEmpty(pic))
                                {
                                    <img src="@pic" alt="" class="rd-avatar" />
                                }
                                else
                                {
                                    <span class="rd-avatar rd-avatar-fallback"><i class="bi bi-person-fill"></i></span>
                                }
                                <span>@userName <span class="badge rd-role-badge">@role</span></span>
                            </a>
                        </li>
                        <li class="nav-item">
                            <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                                <button type="submit" class="btn btn-outline-light btn-sm"><i class="bi bi-box-arrow-right"></i> Log out</button>
                            </form>
                        </li>
                    }
                    else
                    {
                        <li class="nav-item"><a class="nav-link" asp-controller="Account" asp-action="Login">Log in</a></li>
                        <li class="nav-item"><a class="btn btn-rd btn-sm ms-lg-2" asp-controller="Account" asp-action="Register">Sign up</a></li>
                    }
                </ul>
            </div>
        </div>
    </nav>

    <main class="container rd-main">
        @if (TempData["FlashMessage"] is string flash)
        {
            <div class="alert alert-@(TempData["FlashKind"] ?? "success") alert-dismissible fade show" role="alert">
                @flash
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
        @RenderBody()
    </main>

    <footer class="rd-footer">
        <div class="container">RaceDay &middot; South African road running, walking and cycling events</div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
