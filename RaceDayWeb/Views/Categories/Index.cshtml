@model CategoriesPageViewModel
@{ ViewData["Title"] = "Categories - " + Model.Event.Name; }

<a asp-controller="ManageEvents" asp-action="Index" class="rd-back"><i class="bi bi-arrow-left"></i> My events</a>
<h1 class="rd-title mt-2">Categories</h1>
<p class="lead mb-3">@Model.Event.Name &middot; @Model.Event.EventDate.ToString("d MMM yyyy")</p>

<div class="row g-4">
    <div class="col-lg-7">
        <div class="rd-card p-0 table-responsive">
            @if (!Model.Event.Categories.Any())
            {
                <p class="p-4 mb-0">No categories yet. Participants can't enter until you add at least one.</p>
            }
            else
            {
                <table class="table rd-table mb-0 align-middle">
                    <thead><tr><th>Category</th><th>Ages</th><th>Distance</th><th></th></tr></thead>
                    <tbody>
                    @foreach (var c in Model.Event.Categories)
                    {
                        <tr>
                            <td><strong>@c.CategoryName</strong></td>
                            <td>@c.AgeRange</td>
                            <td>@(c.DistanceKm.HasValue ? c.DistanceKm.Value.ToString("0.##") + " km" : "-")</td>
                            <td class="text-end">
                                <form asp-action="Delete" method="post" class="d-inline"
                                      onsubmit="return confirm('Remove this category?');">
                                    <input type="hidden" name="eventId" value="@Model.Event.EventId" />
                                    <input type="hidden" name="categoryId" value="@c.CategoryId" />
                                    <button type="submit" class="btn btn-sm btn-outline-danger">Remove</button>
                                </form>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            }
        </div>
    </div>
    <div class="col-lg-5">
        <div class="rd-card">
            <h2 class="rd-subtitle">Add a category</h2>
            <partial name="_ValidationSummary" />
            <form asp-action="Add" method="post" novalidate>
                <input type="hidden" asp-for="Form.EventId" />
                <div class="mb-3">
                    <label asp-for="Form.CategoryName" class="form-label"></label>
                    <input asp-for="Form.CategoryName" class="form-control" placeholder="e.g. Senior Men 21.1 km" />
                    <span asp-validation-for="Form.CategoryName" class="text-danger small"></span>
                </div>
                <div class="row">
                    <div class="col-6 mb-3">
                        <label asp-for="Form.MinAge" class="form-label"></label>
                        <input asp-for="Form.MinAge" class="form-control" type="number" min="0" />
                        <span asp-validation-for="Form.MinAge" class="text-danger small"></span>
                    </div>
                    <div class="col-6 mb-3">
                        <label asp-for="Form.MaxAge" class="form-label"></label>
                        <input asp-for="Form.MaxAge" class="form-control" type="number" min="0" />
                        <span asp-validation-for="Form.MaxAge" class="text-danger small"></span>
                    </div>
                </div>
                <div class="mb-3">
                    <label asp-for="Form.DistanceKm" class="form-label"></label>
                    <input asp-for="Form.DistanceKm" class="form-control" type="number" step="0.01" min="0.1" />
                    <span asp-validation-for="Form.DistanceKm" class="text-danger small"></span>
                </div>
                <button type="submit" class="btn btn-rd w-100">Add category</button>
            </form>
        </div>
    </div>
</div>
