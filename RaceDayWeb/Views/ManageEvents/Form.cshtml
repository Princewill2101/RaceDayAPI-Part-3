@model EventFormViewModel
@{
    bool isEdit = Model.EventId > 0;
    ViewData["Title"] = isEdit ? "Edit event" : "New event";
}

<a asp-action="Index" class="rd-back"><i class="bi bi-arrow-left"></i> My events</a>
<h1 class="rd-title mt-2">@ViewData["Title"]</h1>

<div class="rd-card">
    <partial name="_ValidationSummary" />
    <form asp-action="@(isEdit ? "Edit" : "Create")" asp-route-id="@(isEdit ? Model.EventId : (int?)null)"
          method="post" enctype="multipart/form-data" novalidate>
        <div class="row g-3">
            <div class="col-md-8">
                <label asp-for="Name" class="form-label"></label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="text-danger small"></span>
            </div>
            <div class="col-md-4">
                <label asp-for="EventTypeId" class="form-label"></label>
                <select asp-for="EventTypeId" asp-items="Model.EventTypes" class="form-select">
                    <option value="">Choose a type...</option>
                </select>
                <span asp-validation-for="EventTypeId" class="text-danger small"></span>
            </div>
            <div class="col-12">
                <label asp-for="Description" class="form-label"></label>
                <textarea asp-for="Description" class="form-control" rows="4"></textarea>
                <span asp-validation-for="Description" class="text-danger small"></span>
            </div>
            <div class="col-md-4">
                <label asp-for="EventDate" class="form-label"></label>
                <input asp-for="EventDate" class="form-control" type="datetime-local" />
                <span asp-validation-for="EventDate" class="text-danger small"></span>
            </div>
            <div class="col-md-5">
                <label asp-for="Location" class="form-label"></label>
                <input asp-for="Location" class="form-control" />
                <span asp-validation-for="Location" class="text-danger small"></span>
            </div>
            <div class="col-md-3">
                <label asp-for="DistanceKm" class="form-label"></label>
                <input asp-for="DistanceKm" class="form-control" type="number" step="0.01" min="0.1" />
                <span asp-validation-for="DistanceKm" class="text-danger small"></span>
            </div>
            <div class="col-12">
                <label asp-for="Banner" class="form-label"></label>
                @if (!string.IsNullOrEmpty(Model.ExistingBannerUrl))
                {
                    <div class="mb-2"><img src="@Model.ExistingBannerUrl" alt="Current banner" class="rd-banner-preview" /></div>
                }
                <input asp-for="Banner" class="form-control" type="file" accept="image/png,image/jpeg,image/webp,image/gif" />
                <div class="form-text">Optional. JPEG, PNG, WEBP or GIF, up to 5 MB.@(isEdit ? " Choose a file only if you want to replace the current banner." : "")</div>
                <span asp-validation-for="Banner" class="text-danger small"></span>
            </div>
        </div>
        <div class="mt-4 d-flex gap-2">
            <button type="submit" class="btn btn-rd">@(isEdit ? "Save changes" : "Create event")</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
        </div>
    </form>
</div>
