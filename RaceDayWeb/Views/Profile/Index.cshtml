@model ProfileViewModel
@{ ViewData["Title"] = "My profile"; }

<h1 class="rd-title">My profile</h1>

<div class="row g-4">
    <div class="col-md-4">
        <div class="rd-card text-center">
            @if (!string.IsNullOrEmpty(Model.ProfilePictureUrl))
            {
                <img src="@Model.ProfilePictureUrl" alt="Profile picture" class="rd-profile-pic" />
            }
            else
            {
                <div class="rd-profile-pic rd-avatar-fallback"><i class="bi bi-person-fill"></i></div>
            }
            <h3 class="mt-3 mb-0">@Model.FullName</h3>
            <span class="badge rd-role-badge">@Model.Role</span>

            <form asp-action="UploadPicture" method="post" enctype="multipart/form-data" class="mt-3 text-start">
                <label class="form-label" for="picture">New profile picture</label>
                <input type="file" id="picture" name="picture" class="form-control mb-2" accept="image/png,image/jpeg,image/webp,image/gif" required />
                <div class="form-text mb-2">JPEG, PNG, WEBP or GIF, up to 5 MB.</div>
                <button type="submit" class="btn btn-outline-rd w-100">Upload picture</button>
            </form>
        </div>
    </div>
    <div class="col-md-8">
        <div class="rd-card">
            <h2 class="rd-subtitle">Your details</h2>
            <partial name="_ValidationSummary" />
            <form asp-action="Update" method="post" novalidate>
                <div class="mb-3">
                    <label asp-for="FullName" class="form-label"></label>
                    <input asp-for="FullName" class="form-control" />
                    <span asp-validation-for="FullName" class="text-danger small"></span>
                </div>
                <div class="mb-3">
                    <label class="form-label">Email</label>
                    <input class="form-control" value="@Model.Email" disabled />
                    <div class="form-text">Your email is your login and can't be changed here.</div>
                </div>
                <button type="submit" class="btn btn-rd">Save changes</button>
            </form>
        </div>
    </div>
</div>
